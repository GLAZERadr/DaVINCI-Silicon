// Verification plan · sync_fifo · live04-breakdown-replay1
// Generated by verify/plan.py from stored files; results are in verification_plan.json.
{
  name: "sync_fifo"
  testpoints: [
    {
      name: "reset_state"
      milestone: "V1"
      desc: "REQ-01. Goal: Synchronous reset empties the FIFO: count 0, empty 1, dout 0, overflow and underflow 0. Stimulus: test_reset_state: after reset the FIFO is empty, count 0, dout 0, no flags. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_reset_state", "test_random_regression"]
    }
    {
      name: "fifo_order_wraparound"
      milestone: "V2"
      desc: "REQ-02. Goal: Data is read out in the order it was written, including across pointer wraparound. Stimulus: test_wraparound_order: data leaves in write order across pointer wraparound. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_wraparound_order", "test_random_regression"]
    }
    {
      name: "full_empty_flags"
      milestone: "V1"
      desc: "REQ-03. Goal: full is 1 exactly when DEPTH entries are stored; empty is 1 exactly when none are. Stimulus: test_full_flag: full asserts exactly when DEPTH entries are stored; test_empty_flag: empty asserts exactly when the last entry is read. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_full_flag", "test_empty_flag", "test_random_regression"]
    }
    {
      name: "overflow_write_when_full"
      milestone: "V2"
      desc: "REQ-04. Goal: A write when full with no read is ignored and pulses overflow for one cycle. Stimulus: test_overflow: a write when full (no read) is ignored and flags overflow. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_overflow", "test_random_regression"]
    }
    {
      name: "underflow_read_when_empty"
      milestone: "V2"
      desc: "REQ-05. Goal: A read when empty is ignored, pulses underflow for one cycle, and dout holds its value. Stimulus: test_underflow: a read when empty is ignored, flags underflow, dout holds. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_underflow", "test_random_regression"]
    }
    {
      name: "read_write_when_full"
      milestone: "V2"
      desc: "REQ-06. Goal: Read and write in the same cycle when full: the oldest word is read, the new word is stored, count stays DEPTH. Stimulus: test_full_simultaneous_rw: read + write when full reads the oldest, stores the new word. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_full_simultaneous_rw", "test_random_regression"]
    }
    {
      name: "read_write_when_empty"
      milestone: "V2"
      desc: "REQ-07. Goal: Read and write in the same cycle when empty: the word is stored, the read is ignored, underflow pulses. Stimulus: test_empty_simultaneous_rw: read + write when empty stores the word and flags underflow. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_empty_simultaneous_rw", "test_random_regression"]
    }
    {
      name: "almost_full_threshold"
      milestone: "V1"
      desc: "REQ-08. Goal: almost_full is 1 exactly when count >= AF_THRESH. Stimulus: test_almost_full: almost_full is high exactly when count >= AF_THRESH. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_almost_full", "test_random_regression"]
    }
    {
      name: "count_tracks_occupancy"
      milestone: "V1"
      desc: "REQ-09. Goal: count equals the number of stored entries after every cycle. Stimulus: test_full_flag: full asserts exactly when DEPTH entries are stored. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_full_flag", "test_random_regression"]
    }
    {
      name: "no_overflow_read_write_when_full"
      milestone: "V2"
      desc: "REQ-10. Goal: A write when full together with a read in the same cycle is accepted: overflow stays 0. Stimulus: test_full_simultaneous_rw: read + write when full reads the oldest, stores the new word. Check: every output compared with the cycle-accurate golden model on every clock (scoreboard)."
      tests: ["test_full_simultaneous_rw", "test_random_regression"]
    }
  ]
