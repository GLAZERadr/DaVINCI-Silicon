# Copy to .env and fill in. Never commit .env.
META_API_KEY=
BASETEN_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# USD per 1M tokens. Live calls are refused while these are empty.
PRICE_IN_META=
PRICE_OUT_META=
PRICE_IN_BASETEN=
PRICE_OUT_BASETEN=

# Hard stop for live spend, summed from runs/_ledger.jsonl.
DAVINCI_BUDGET_USD=120

# Provider per step: meta | baseten | replay | fake
DAVINCI_PROVIDER=meta
DAVINCI_PROVIDER_GEN=
DAVINCI_PROVIDER_REPAIR=
DAVINCI_REASONING_EFFORT=

# API: bearer token required for runs that call a live model (unset = open).
DAVINCI_API_TOKEN=
DAVINCI_CORS_ORIGINS=http://localhost:3000
DAVINCI_SANDBOX=local
